*unreachable func: messagesMaxTokens
*unreachable func: renderMessagesTurns
*unreachable func: sawDialogAfterSystem
*unreachable func: messagesSystemBlocks
*unreachable func: messagesTurn
*unreachable func: messagesToolResultBlock
*unreachable func: messagesResultContent
*unreachable func: messagesMediaBlock
